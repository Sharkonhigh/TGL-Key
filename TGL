local function HasItemInInventory(itemName)
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    local char = LocalPlayer.Character
    
    if backpack and backpack:FindFirstChild(itemName) then
        return true
    end
    if char and char:FindFirstChild(itemName) then
        return true
    end
    return false
end

local function TriggerPurchasePart(partName)
    local buyPart = Workspace:FindFirstChild(partName, true)
    if buyPart then
        local clickDetector = buyPart:FindFirstChildOfClass("ClickDetector") or buyPart:FindFirstChild("ClickDetector", true)
        if clickDetector and fireclickdetector then
            fireclickdetector(clickDetector)
            return true
        end
    end
    if fireclickdetector then
        for _, v in ipairs(Workspace:GetDescendants()) do
            if v.Name == partName then
                local cd = v:FindFirstChildOfClass("ClickDetector") or v:FindFirstChild("ClickDetector", true)
                if cd then 
                    fireclickdetector(cd) 
                    return true
                end
            end
        end
    end
    return false
end

local function ExecuteBuyAction(itemName, partName, posVector, isWeapon)
    if isWeapon and HasItemInInventory(itemName) then
        ShowNotification("❌ Couldnt bought already in inventory", true)
        return
    end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local savedCFrame = hrp.CFrame

    hrp.CFrame = CFrame.new(posVector)
    task.wait(0.2)

    TriggerPurchasePart(partName)
    task.wait(0.3)

    if hrp then
        hrp.CFrame = savedCFrame
    end

    if isWeapon then
        if HasItemInInventory(itemName) then
            ShowNotification("Successfully bought " .. itemName .. "!")
        else
            ShowNotification("Purchased attempted for " .. itemName)
        end
    else
        ShowNotification("Bought item: " .. itemName)
    end
end

