end

if not isfolder(ConfigFolder) then
    makefolder(ConfigFolder)
end

local function SaveConfig(configName)
    if not configName or configName == "" then return end
    local data = {
        WalkSpeedValue = Settings.WalkSpeedValue,
        HipHeightValue = Settings.HipHeightValue,
        FlySpeed = Settings.FlySpeed,
        SpinSpeed = Settings.SpinSpeed,
        FOVValue = Settings.FOVValue,
        InfJumpEnabled = Settings.InfJumpEnabled,
        HighlightEnabled = Settings.HighlightEnabled,
        NameTagEnabled = Settings.NameTagEnabled,
        HealthBarEnabled = Settings.HealthBarEnabled,
        FlyEnabled = Settings.FlyEnabled,
        SpinEnabled = Settings.SpinEnabled,
        NoclipEnabled = Settings.NoclipEnabled,
        RainbowSkinEnabled = Settings.RainbowSkinEnabled,
        HeadlessEnabled = Settings.HeadlessEnabled,
        FOVEnabled = Settings.FOVEnabled,
        LockEnabled = Settings.LockEnabled,
        StrafeEnabled = Settings.StrafeEnabled,
        AntiStompEnabled = Settings.AntiStompEnabled,
        EmoteSpeed = Settings.EmoteSpeed
    }
    local success, encoded = pcall(function()
        return HttpService:JSONEncode(data)
    end)
    if success then
        writefile(ConfigFolder .. "/" .. configName .. ".json", encoded)
    end
end

local function LoadConfig(configName)
    local path = ConfigFolder .. "/" .. configName .. ".json"
    if not pcall(function() readfile(path) end) then return end
    local success, decoded = pcall(function()
        return HttpService:JSONDecode(readfile(path))
    end)
    if success and type(decoded) == "table" then
        for k, v in pairs(decoded) do
            if Settings[k] ~= nil then
                Settings[k] = v
                if ToggleUpdateCallbacks[k] then
                    ToggleUpdateCallbacks[k](v)
                end
            end
        end
    end
end

local function DeleteConfig(configName)
    local path = ConfigFolder .. "/" .. configName .. ".json"
    if isfile and isfile(path) and delfile then
        delfile(path)
    elseif delfile then
        pcall(function() delfile(path) end)
    end
end

