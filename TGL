end

LocalPlayer.CharacterAdded:Connect(function(newChar)
    IsFrozen = false
    Settings.IsLocked = false
    Settings.CurrentTarget = nil
    
    local hum = newChar:WaitForChild("Humanoid", 5)
    if hum then AttachHumanoidHooks(hum) end
    if Settings.FlyEnabled then
        Settings.IsFlying = true
    end
end)

RunService.RenderStepped:Connect(function(deltaTime)
    MenuBlur.Enabled = MainFrame.Visible
    SpinningText3D.Visible = MainFrame.Visible

    if MainFrame.Visible then
        textSpinAngle = (textSpinAngle + (45 * deltaTime)) % 360
        SpinningText3D.Rotation = textSpinAngle
    end

    local char = LocalPlayer.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    if Settings.AntiStompEnabled and hum.Health > 0 and hum.Health <= 3 then
        hum.Health = 0
        char:BreakJoints()
        task.delay(0.1, function()
            if char and char.Parent then
                char:Destroy()
            end
        end)
        ShowNotification("AntiStomp Activated: Character Reset!")
        return
    end

    if hum.Health <= 0 then return end

    if IsFrozen then
        hrp.Anchored = true
        return
    else
        hrp.Anchored = false
    end

    hum.WalkSpeed = Settings.WalkSpeedValue
    hum.HipHeight = Settings.HipHeightValue

    if Settings.FOVEnabled then
        Camera.FieldOfView = Settings.FOVValue
    end

    rainbowHue = (rainbowHue + (deltaTime * 0.5)) % 1
    local currentRainbowColor = Color3.fromHSV(rainbowHue, 1, 1)

    Title.TextColor3 = currentRainbowColor

    if Settings.RainbowSkinEnabled then
        if not isRainbowActiveSnapshot then
            isRainbowActiveSnapshot = true
            OriginalColors = {}
            OriginalClothing = {}
            for _, p in ipairs(char:GetChildren()) do
                if p:IsA("BasePart") then
                    OriginalColors[p.Name] = p.Color
                elseif p:IsA("Shirt") or p:IsA("Pants") or p:IsA("Clothing") then
                    table.insert(OriginalClothing, p)
                    p.Parent = nil
                end
            end
        end

        Settings.RainbowTimer = Settings.RainbowTimer + deltaTime
        if Settings.RainbowTimer >= 0.25 then
            Settings.RainbowTimer = 0
            Settings.RainbowColorIndex = (Settings.RainbowColorIndex % #RobloxSkinPalette) + 1
        end

        local palColor = RobloxSkinPalette[Settings.RainbowColorIndex]
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                if part.Name == "Head" and Settings.HeadlessEnabled then
                    part.Transparency = 1
                else
                    part.Color = palColor
                end
            end
        end
    else
        if isRainbowActiveSnapshot then
            isRainbowActiveSnapshot = false
            RestoreOriginalSkinAndClothing()
        end
    end

    if Settings.HeadlessEnabled then
        local head = char:FindFirstChild("Head")
        if head then
            head.Transparency = 1
            local decal = head:FindFirstChildOfClass("Decal")
            if decal then decal.Transparency = 1 end
        end
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Accessory") then
                local handle = item:FindFirstChild("Handle")
                if handle then handle.Transparency = 1 end
            end
        end
    end

    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            part.LocalTransparencyModifier = part.Transparency
        end
    end

    if Settings.SpinEnabled then
        hum.AutoRotate = false
        hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(Settings.SpinSpeed), 0)
    end

    if Settings.LockEnabled and Settings.IsLocked then
        if not Settings.CurrentTarget or not Settings.CurrentTarget.Character or not Settings.CurrentTarget.Character:FindFirstChildOfClass("Humanoid") or Settings.CurrentTarget.Character:FindFirstChildOfClass("Humanoid").Health <= 0 then
            Settings.CurrentTarget = GetClosestPlayerToMouse()
        end

        if Settings.CurrentTarget and Settings.CurrentTarget.Character then
            local tChar = Settings.CurrentTarget.Character
            local tHead = tChar:FindFirstChild("Head")
            local tHum = tChar:FindFirstChildOfClass("Humanoid")
            
            if tHead and tHum and tHum.Health > 0 then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, tHead.Position)
            else
                Settings.CurrentTarget = nil
            end
        end
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local pChar = p.Character
            local pHrp = pChar:FindFirstChild("HumanoidRootPart")
            local pHum = pChar:FindFirstChildOfClass("Humanoid")
            local pHead = pChar:FindFirstChild("Head")

            local esp = pChar:FindFirstChild("GrimESP")
            if Settings.HighlightEnabled then
                if not esp then
                    esp = Instance.new("Highlight")
                    esp.Name = "GrimESP"
                    esp.FillTransparency = 0.6
                    esp.Parent = pChar
                end
                esp.FillColor = currentRainbowColor
                esp.OutlineColor = currentRainbowColor
            else
                if esp then esp:Destroy() end
            end

            local tagGui = pChar:FindFirstChild("GrimTagGui")
            if (Settings.NameTagEnabled or Settings.HealthBarEnabled) and pHrp and pHead and pHum and pHum.Health > 0 then
                if not tagGui then
                    tagGui = Instance.new("BillboardGui")
                    tagGui.Name = "GrimTagGui"
                    tagGui.Size = UDim2.new(0, 100, 0, 36)
                    tagGui.StudsOffset = Vector3.new(0, 2.4, 0)
                    tagGui.AlwaysOnTop = true
                    tagGui.Parent = pChar

                    local nameLabel = Instance.new("TextLabel")
                    nameLabel.Name = "NameLabel"
                    nameLabel.Size = UDim2.new(1, 0, 0, 16)
                    nameLabel.Position = UDim2.new(0, 0, 0, 0)
                    nameLabel.BackgroundTransparency = 1
                    nameLabel.Font = Enum.Font.SourceSansBold
                    nameLabel.TextSize = 12
                    nameLabel.TextStrokeTransparency = 0.5
                    nameLabel.Parent = tagGui

                    local bgBar = Instance.new("Frame")
                    bgBar.Name = "BgBar"
                    bgBar.Size = UDim2.new(0.9, 0, 0, 5)
                    bgBar.Position = UDim2.new(0.05, 0, 0, 20)
                    bgBar.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                    bgBar.BorderSizePixel = 0
                    bgBar.Parent = tagGui

                    local bgCorner = Instance.new("UICorner")
                    bgCorner.CornerRadius = UDim.new(0, 2)
                    bgCorner.Parent = bgBar

                    local healthBar = Instance.new("Frame")
                    healthBar.Name = "HealthBar"
                    healthBar.Size = UDim2.new(1, 0, 1, 0)
                    healthBar.BackgroundColor3 = Color3.fromRGB(50, 220, 100)
                    healthBar.BorderSizePixel = 0
                    healthBar.Parent = bgBar

                    local barCorner = Instance.new("UICorner")
                    barCorner.CornerRadius = UDim.new(0, 2)
                    barCorner.Parent = healthBar
                end

                local nLbl = tagGui:FindFirstChild("NameLabel")
                local bg = tagGui:FindFirstChild("BgBar")
                local hBar = bg and bg:FindFirstChild("HealthBar")

                if nLbl then
                    nLbl.Visible = Settings.NameTagEnabled
                    nLbl.Text = p.DisplayName
                    nLbl.TextColor3 = currentRainbowColor
                end
                if bg and hBar then
                    bg.Visible = Settings.HealthBarEnabled
                    local healthPct = math.clamp(pHum.Health / pHum.MaxHealth, 0, 1)
                    hBar.Size = UDim2.new(healthPct, 0, 1, 0)
                    hBar.BackgroundColor3 = Color3.fromRGB(255 - (healthPct * 255), healthPct * 255, 50)
                end
            else
                if tagGui then tagGui:Destroy() end
            end
        end
    end

    if Settings.FlyEnabled and Settings.IsFlying then
        local moveDir = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0, 1, 0) end

        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.CFrame = hrp.CFrame + (moveDir * Settings.FlySpeed * deltaTime)
    end

    if Settings.StrafeEnabled and Settings.IsStrafing and Settings.CurrentTarget then
        local tChar = Settings.CurrentTarget.Character
        local tHead = tChar and tChar:FindFirstChild("Head")
        if tHead then
            angle = (angle + (Settings.StrafeSpeed * deltaTime)) % (math.pi * 2)
            local offset = Vector3.new(math.cos(angle) * Settings.StrafeDistance, 0, math.sin(angle) * Settings.StrafeDistance)
            hrp.CFrame = CFrame.new(tHead.Position + offset, tHead.Position)
        else
            Settings.IsStrafing = false
        end
    end

    if isPlayerOrbiting and selectedTargetPlayer and selectedTargetPlayer.Character then
        local tHead = selectedTargetPlayer.Character:FindFirstChild("Head")
        if tHead then
            pOrbitAngle = (pOrbitAngle + (5 * deltaTime)) % (math.pi * 2)
            local offset = Vector3.new(math.cos(pOrbitAngle) * 6, 0, math.sin(pOrbitAngle) * 6)
            hrp.CFrame = CFrame.new(tHead.Position + offset, tHead.Position)
        end
    end

    if isHeadsitting and selectedTargetPlayer and selectedTargetPlayer.Character then
        local tHead = selectedTargetPlayer.Character:FindFirstChild("Head")
        if tHead then
            hrp.CFrame = tHead.CFrame + Vector3.new(0, 1.5, 0)
            hrp.AssemblyLinearVelocity = Vector3.zero
        end
    end
end)

RunService.Stepped:Connect(function()
    if Settings.NoclipEnabled and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)
