local function PlayEmoteAnimation(assetId)
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    
    if CurrentEmoteTrack then
        CurrentEmoteTrack:Stop()
        CurrentEmoteTrack = nil
    end

    task.spawn(function()
        local success, objects = pcall(function()
            return game:GetObjects("rbxassetid://" .. tostring(assetId))
        end)

        local animObject = nil
        if success and objects and #objects > 0 then
            for _, obj in ipairs(objects) do
                if obj:IsA("Animation") then
                    animObject = obj
                    break
                elseif obj:IsA("Folder") or obj:IsA("Model") then
                    animObject = obj:FindFirstChildOfClass("Animation", true)
                    if animObject then break end
                end
            end
        end

        if not animObject then
            animObject = Instance.new("Animation")
            animObject.AnimationId = "rbxassetid://" .. tostring(assetId)
        end

        CurrentEmoteTrack = hum:LoadAnimation(animObject)
        CurrentEmoteTrack.Priority = Enum.AnimationPriority.Action
        CurrentEmoteTrack:Play()
        CurrentEmoteTrack:AdjustSpeed(Settings.EmoteSpeed / 10)
    end)
end

