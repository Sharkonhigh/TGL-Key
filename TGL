-------------------------------------------------------------
-- ADVANCED FLING PLAYER SYSTEM (PHYSICAL COLLISION & ANTI-VOID)
-------------------------------------------------------------
local isAutoFlingEnabled = false

local function ExecuteFling(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return end
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local targetHead = targetPlayer.Character:FindFirstChild("Head") or targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    
    if not myHrp or not targetHead then return end

    local savedPos = myHrp.CFrame
    ShowNotification("Flinging " .. targetPlayer.DisplayName .. "...")

    local bV = Instance.new("BodyVelocity")
    bV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bV.Velocity = Vector3.new(99999, 99999, 99999)
    bV.Parent = myHrp

    local bAV = Instance.new("BodyAngularVelocity")
    bAV.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bAV.AngularVelocity = Vector3.new(99999, 99999, 99999)
    bAV.Parent = myHrp

    local startTime = tick()
    local flingConn
    flingConn = RunService.Heartbeat:Connect(function()
        if tick() - startTime > 1.8 or not targetPlayer.Character or not targetPlayer.Character:FindFirstChildOfClass("Humanoid") or targetPlayer.Character:FindFirstChildOfClass("Humanoid").Health <= 0 then
            flingConn:Disconnect()
            bV:Destroy()
            bAV:Destroy()
            
            myHrp.AssemblyLinearVelocity = Vector3.zero
            myHrp.AssemblyAngularVelocity = Vector3.zero
            myHrp.CFrame = savedPos
            ShowNotification("Fling Completed!")
            return
        end

        if myHrp.Position.Y < -100 then
            myHrp.CFrame = savedPos + Vector3.new(0, 5, 0)
            myHrp.AssemblyLinearVelocity = Vector3.zero
        else
            myHrp.CFrame = targetHead.CFrame * CFrame.Angles(math.rad(math.random(-360, 360)), math.rad(math.random(-360, 360)), math.rad(math.random(-360, 360)))
        end
    end)
end

CreateButton("Players", "Fling Player", Color3.fromRGB(220, 50, 50), function()
    if selectedTargetPlayer then
        ExecuteFling(selectedTargetPlayer)
    else
        ShowNotification("Select a player first!")
    end
end)

CreateToggle("Players", "Auto Fling (On Spawn)", "AutoFlingEnabled", false, function(v)
    isAutoFlingEnabled = v
    if v then
        ShowNotification("Auto Fling Enabled")
        task.spawn(function()
            while isAutoFlingEnabled do
                if selectedTargetPlayer and selectedTargetPlayer.Character then
                    local hum = selectedTargetPlayer.Character:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        ExecuteFling(selectedTargetPlayer)
                        repeat task.wait(0.5) until not selectedTargetPlayer or not selectedTargetPlayer.Character or not selectedTargetPlayer.Character:FindFirstChildOfClass("Humanoid") or selectedTargetPlayer.Character:FindFirstChildOfClass("Humanoid").Health <= 0 or not isAutoFlingEnabled
                        task.wait(2)
                    end
                end
                task.wait(1)
            end
        end)
    else
        ShowNotification("Auto Fling Disabled")
    end
end)


