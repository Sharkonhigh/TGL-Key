local function RestoreHeadAndHats()
    local char = LocalPlayer.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if head then
        head.Transparency = 0
        local decal = head:FindFirstChildOfClass("Decal")
        if decal then decal.Transparency = 0 end
    end
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Accessory") then
            local handle = item:FindFirstChild("Handle")
            if handle then handle.Transparency = 0 end
        end
    end
end

local function RestoreOriginalSkinAndClothing()
    local char = LocalPlayer.Character
    if not char then return end
    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") and OriginalColors[part.Name] then
            part.Color = OriginalColors[part.Name]
        end
    end
    for _, cloth in ipairs(OriginalClothing) do
        if cloth and cloth.Parent == nil then
            cloth.Parent = char
        end
    end
    OriginalClothing = {}
end

