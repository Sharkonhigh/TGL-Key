UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end

    if input.KeyCode == Enum.KeyCode.Space and Settings.InfJumpEnabled and not IsFrozen then
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChild("Humanoid")
        if hrp and hum and hum.Health > 0 then
            hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, hum.JumpPower > 0 and hum.JumpPower or 50, hrp.AssemblyLinearVelocity.Z)
        end
    end

    if input.KeyCode == Settings.UIParentKey then
        MainFrame.Visible = not MainFrame.Visible
    elseif input.KeyCode == Settings.LockKey and Settings.LockEnabled then
        Settings.IsLocked = not Settings.IsLocked
        if Settings.IsLocked then
            Settings.CurrentTarget = GetClosestPlayerToMouse()
        else
            Settings.CurrentTarget = nil
        end
    elseif input.KeyCode == Settings.FlyKey and Settings.FlyEnabled then
        Settings.IsFlying = not Settings.IsFlying
        ShowNotification(Settings.IsFlying and "flyed" or "unflyed")
    elseif input.KeyCode == Settings.StrafeKey and Settings.StrafeEnabled then
        Settings.IsStrafing = not Settings.IsStrafing
        if Settings.IsStrafing then Settings.CurrentTarget = GetClosestPlayerToMouse() end
    end
end)

